{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devfest-spaeti",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-lite-tts",
    "TTS_PROVIDER": "gemini",
    "LLM_PROVIDER": "gemini"
  },
  // Secrets (wrangler secret put): DEVICE_TOKEN, GEMINI_API_KEY, optional SPAETI_VOICE_ID
  "durable_objects": {
    "bindings": [{ "name": "Spaeti", "class_name": "Spaeti" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Spaeti"] }]
}
